{
  "name": "bb-plugin-omarchy",
  "version": "0.1.0",
  "description": "Keep BB perfectly in step with the active Omarchy theme.",
  "author": "Salem Sayed Abdel Gawad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salemsayed/bb-plugin-omarchy.git"
  },
  "homepage": "https://github.com/salemsayed/bb-plugin-omarchy#readme",
  "bugs": {
    "url": "https://github.com/salemsayed/bb-plugin-omarchy/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.4.34 <0.5.0"
  },
  "bb": {
    "name": "Omarchy Sync",
    "description": "Live Omarchy palette, syntax theme, ANSI colors, favicon tint, and animated transitions for BB.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": []
